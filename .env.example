# Google service account (calendar.readonly)
# Set exactly one of the two: the key file path, or the key JSON itself.
# docker compose overrides the path to the mounted /run/secrets/google-service-account.json.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/google-service-account.json
# Alternative, outside Docker only: the whole JSON key on one line (then remove the line above). Under docker compose leave this unset; compose always sets the key file path.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# WAHA (WhatsApp HTTP API)
# docker compose overrides WAHA_URL to http://waha:3000 for the app container.
# Still required here (config validation); use http://127.0.0.1:3000 when running outside Docker.
WAHA_URL=http://127.0.0.1:3000 
WAHA_SESSION=default
WAHA_API_KEY=change-me
# WAHA dashboard / Swagger login (used by docker-compose.yml)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-too
# WAHA_IMAGE=devlikeapro/waha:gows-arm-2026.10.1   # only on ARM (Apple Silicon Mac / ARM server); default is the amd64 GOWS image

# Failure alerts
ALERT_EMAIL_TO=ops@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ops@example.com
SMTP_PASS="app-password"

# Admin UI (see README "Admin UI")
# Superadmin: can always sign in and manages other admins.
SUPERADMIN_EMAIL=you@example.com
# Password login for the superadmin, at least 12 characters. Generate with: openssl rand -base64 18
# At least one of ADMIN_PASSWORD or GOOGLE_OAUTH_CLIENT_ID is required.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Google sign-in (optional): Google Cloud Console > APIs & Services > Credentials > Create credentials >
# OAuth client ID > Web application. Add the authorised JavaScript origins, e.g.
# https://admin.example.com and http://localhost:8081
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Port of the admin UI (host side under docker compose; published on 127.0.0.1 only).
# ADMIN_PORT=8081
# Set to true when the admin UI is served over HTTPS (e.g. behind Caddy): marks the session cookie Secure.
# ADMIN_COOKIE_SECURE=false
# Set to true only behind a reverse proxy you control: the login rate limit then uses X-Forwarded-For.
# ADMIN_TRUST_PROXY=false

# Nudge (tasks product, see README "Nudge"). The `nudge` compose service sets SERVICE_ROLE=tasks itself.
# Public URL of Nudge, used for links in WhatsApp messages (<url>/#/t/<id>, <url>/#/my). Unset: messages carry no links.
# TASKS_PUBLIC_URL=https://nudge.grittaai.com
# Product name used in the sign-in email subject ("Your <APP_NAME> sign-in code").
# APP_NAME=Nudge
# Host port of Nudge (published on 127.0.0.1 only) and its health port inside the container.
# TASKS_PORT=8082
# TASKS_HEALTH_PORT=8083

# Optional
# DB_PATH=data/app.db
# First-start import only: seeds an empty database, never read again afterwards.
# CONFIG_PATH=config.json
# LOG_LEVEL=info
# HEALTH_PORT=8080
